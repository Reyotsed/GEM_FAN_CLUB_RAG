# ===== LLM Provider =====
# zhipuai | deepseek | openai
LLM_PROVIDER=deepseek

# ===== ZhipuAI（用于 embedding，必须配置）=====
# 即使 LLM_PROVIDER=deepseek，embedding 仍用智谱
ZHIPUAI_API_KEY=
ZHIPUAI_EMBEDDING_MODEL=embedding-3
ZHIPUAI_TIMEOUT=120

# ===== DeepSeek（LLM_PROVIDER=deepseek 时生效）=====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_FAST_MODEL=deepseek-chat
DEEPSEEK_TEMPERATURE=0.8

# ===== ZhipuAI（LLM_PROVIDER=zhipuai 时生效）=====
ZHIPUAI_MODEL=glm-4.7
ZHIPUAI_FAST_MODEL=glm-4-flash
ZHIPUAI_TEMPERATURE=0.8

# ===== Runtime =====
RUNTIME_MODE=agent
HOST=0.0.0.0
PORT=8000
GRACEFUL_SHUTDOWN_TIMEOUT=30

# ===== Memory backend =====
# redis_pg | inmemory
MEMORY_BACKEND=redis_pg
REDIS_URL=redis://:changeme@localhost:6379/0
REDIS_PASSWORD=changeme
POSTGRES_USER=gem
POSTGRES_PASSWORD=gem
POSTGRES_DB=gem_memory
POSTGRES_DSN=postgresql://gem:gem@localhost:5432/gem_memory

# Memory tunables
SESSION_TTL_DAYS=30
SESSION_MAX_RAW_MESSAGES=200
PROFILE_UPDATE_EVERY_N_TURNS=10
LONG_TERM_TOP_K=3
EMBEDDING_DIM=1024

# ===== Context budget =====
MAX_INPUT_TOKENS=8000
QUOTA_STRATEGY=500
QUOTA_DOCS=3000
QUOTA_PHOTOS=1500
QUOTA_PROFILE=300
QUOTA_LONG_TERM=500
QUOTA_SUMMARY=500

# ===== Chroma =====
CHROMA_PATH=./chroma_db_zhipu
CHROMA_HOST=
CHROMA_PORT=8001

# ===== Tavily (optional) =====
TAVILY_API_KEY=

# ===== Photo skill (curated GEM photo retrieval) =====
PHOTO_SKILL_ENABLED=true
PHOTO_BACKEND_BASE_URL=http://localhost:7071
PHOTO_SYNC_KEY=
PHOTO_REFRESH_TTL_SECONDS=600
PHOTO_FETCH_TIMEOUT_SECONDS=5
PHOTO_MIN_SCORE=0
PHOTO_DEFAULT_TOP_K=3
PHOTO_MAX_TOP_K=6

# ===== Logging / metrics =====
LOG_LEVEL=INFO
LOG_JSON=true
METRICS_ENABLED=true
